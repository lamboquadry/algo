ALGORITHM sum_distinct
VAR
    set1 : ARRAY[1..4] OF INTEGER;
    set2 : ARRAY[1..5] OF INTEGER;
    sum : INTEGER;
    found : BOOLEAN;
    i : INTEGER;
    j : INTEGER;
BEGIN
    set1[1] := 3;
    set1[2] := 1;
    set1[3] := 7;
    set1[4] := 9;

    set2[1] := 2;
    set2[2] := 4;
    set2[3] := 1;
    set2[4] := 9;
    set2[5] := 3;

    sum := 0;

    (* Check elements of set1 in set2 *)
    FOR i FROM 1 TO 4 DO
        found := FALSE;

        FOR j FROM 1 TO 5 DO
            IF set1[i] = set2[j] THEN
                found := TRUE;
            END_IF
        END_FOR

        IF found = FALSE THEN
            sum := sum + set1[i];
        END_IF
    END_FOR

    (* Check elements of set2 in set1 *)
    FOR i FROM 1 TO 5 DO
        found := FALSE;

        FOR j FROM 1 TO 4 DO
            IF set2[i] = set1[j] THEN
                found := TRUE;
            END_IF
        END_FOR

        IF found = FALSE THEN
            sum := sum + set2[i];
        END_IF
    END_FOR

    Write(sum);
END